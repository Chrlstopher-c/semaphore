# Adresses des services joints par Echo.
#
# `☠` Ne mets JAMAIS une adresse réelle dans un fichier suivi par git : ce dépôt
# est public, et l'adresse d'un service est l'adresse d'une machine. Copie ce
# fichier en `.env.local` — ignoré par git — et mets tes vraies valeurs dedans.
# `build.sh` les injecte dans `.build/Info.plist` au moment de compiler.
#
# Sans `.env.local`, l'app compile avec les exemples ci-dessous : elle démarre,
# et les adresses se saisissent dans Réglages.

# Saily, par le tunnel
ECHO_ADRESSE_SAILY=https://saily.example.com

# ccremote : le tunnel, puis le repli LAN quand le tunnel est coupé
ECHO_ADRESSE_CCREMOTE=https://ccremote.example.com
ECHO_ADRESSE_CCREMOTE_LAN=http://10.0.0.2:8766

# EchoHub, relais d'inférence sur le réseau local
ECHO_ADRESSE_ECHOHUB=http://10.0.0.2:8947

# Iris : relais de signalisation du Pi et clé partagée (IRIS_CLE des récepteurs)
ECHO_ADRESSE_IRIS=wss://iris.example.com/ws
ECHO_CLE_IRIS=

